#######################################################################
#
# TABLE OF CONTENTS
#
# <@@toc>
#	The first phase has written the TOC file. This phase will insert
#	the contents at this place.
#
#######################################################################

proc toc {none} {
    puts "<H1>Table of Contents</H1>"
    if [catch {open "toc.out" "r"} toc_out] {
        error "Unable to open file 'toc.out'"
        exit 1
    }
    puts "<DL>"
    while {[gets $toc_out line] != -1} {
        puts $line
    }
    puts "</DL>"
    close $toc_out
}

#######################################################################
#
# CROSS REFERENCING
#
# <@@xref>
#   Substitute the unique ID for the associated number.  
#
#######################################################################

source "./xref.out"

proc xref {ref} {
    global xref
    puts $xref($ref)
}

