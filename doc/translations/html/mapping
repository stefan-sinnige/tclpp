<abstract>		"<P><CENTER><H2>Abstract</H2></CENTER>"
</abstract>		""

<article>		"<HTML>"
</article>		"</HTML>"

<author>		"<P><CENTER>"
</author>		"</CENTER></P>"

<caption>	+	"<@@caption>"
</caption>	+	"<@@endcaption>"			+

<chapt>		+	"<@@chapt>"
</chapt>	+	"<@@endchapt>"				+

<code>			"<PRE>"
</code>			"</PRE>"

<column>		"<TD>"
</column>		"</TD>"

<cright>		"<P><CENTER>Copyright &#169; "
</cright>		"</CENTER></P>"

<date>			"<P><CENTER>"
</date>			"</CENTER></P>"

<enum>			"<OL>"
</enum>			"</OL>"

<figure>	+	"<@@figure>"				+
</figure>	+	"<@@endfigure>"				+

<footnote>		"<@@footnote>"
</footnote>		"<@@endfootnote>"

<file>			"<P><CENTER><IMG SRC=[SRC].gif BORDER=0>"
</file>			"</IMG></CENTER></P>"

<heading>		""
</heading>	+	""

<it>			"<I>"
</it>			"</I>"

<item>			"<LI>"
</item>			"</LI>"

<itemize>		"<UL>"
</itemize>		"</UL>"

<label>		+	"<@@newxref>[ID]"			+
</label>		""

<newline>		"<BR>"
</newline>		""

<p>			"<DD>"
</p>			""

<part>		+	"<@@part>"
</part>		+	"<@@endpart>"				+

<preface>		"<P><H2>Preface</H2>"
</preface>		""

<ref>		+	"<@@xref>[ID]"				+
</ref>			""

<row>			"<TR VALIGN=TOP>"
</row>			"</TR>"

<sect>		+	"<@@sect>"
</sect>		+	"<@@endsect>"				+

<ssect>		+	"<@@ssect>"
</ssect>	+	"<@@endssect>"				+

<sssect>	+	"<@@sssect>"
</sssect>	+	"<@@endsssect>"				+

<table>			"<CENTER><TABLE BORDER=[BORDER] WIDTH=[WIDTH]>"
</table>		"</TABLE></CENTER>"

<title>		+	"<@@title>"
</title>	+	"<@@endtitle>"				+

<toc>		+	"<@@toc>"				+
</toc>			""

<tt>			"<TT>"
</tt>			"</TT>"

<version>	 	"<P><CENTER><H3><I>"
</version>	 	"</I></H3></CENTER><P>"

