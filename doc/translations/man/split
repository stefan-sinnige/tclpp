#######################################################################
#
# MANUAL PAGE SPLITTING
#
# <@@manpage [BASENAME]>
# <@@endmanpage>
#   Substitute the unique ID for the associated number.  
#
#######################################################################

proc manpage {basename} {
    global outfd

    #
    # Open the file for writing
    #

    if [catch {open $basename w} outfd] {
        error "Unable to open '$basename' for writing: $outfd"
        exit 1
    }
    puts stdout "$basename"
}

proc endmanpage {none} {
    global outfd

    #
    # Close the file and set the 'outfd' to stdout
    #

    if {$outfd != "stdout"} {
        close $outfd
    }
    set outfd stdout
}

