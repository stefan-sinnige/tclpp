# ----------------------------------------------------------------------------
# Default top-level directories in which to install architecture-
# specific files (exec_prefix) and machine-independent files such
# specific files (exec_prefix) and machine-independent files such
# as scripts (prefix).  The values specified here may be overridden
# at configure-time with the --exec-prefix and --prefix options
# to the "configure" script.
# ----------------------------------------------------------------------------

prefix	  = @prefix@
exec_prefix = @exec_prefix@

# ----------------------------------------------------------------------------
# The following definition can be set to non-null for special systems
# like AFS with replication.  It allows the pathnames used for installation
# to be different than those used for actually reference files at
# run-time.  INSTALL_ROOT is prepended to $prefix and $exec_prefix
# when installing files.
# ----------------------------------------------------------------------------

INSTALL_ROOT =

# ----------------------------------------------------------------------------
# Directory in which to install documentation
# ----------------------------------------------------------------------------

INSTALL          = ../config/install-sh
MAN_INSTALL_DIR  = $(INSTALL_ROOT)$(prefix)/man
MAN1_INSTALL_DIR = $(MAN_INSTALL_DIR)/man1
MAN3_INSTALL_DIR = $(MAN_INSTALL_DIR)/man3
MANN_INSTALL_DIR = $(MAN_INSTALL_DIR)/mann

# ----------------------------------------------------------------------------
# The sgml-tools.
# ----------------------------------------------------------------------------

NSGMLS 	 = @NSGMLS@
SGMLSASP = @SGMLSASP@

# ----------------------------------------------------------------------------
# The information below should be usable as is.
# ----------------------------------------------------------------------------

SRCS		= \
			tclpp.sgml	

# ----------------------------------------------------------------------------
#
# RULES 
#
# ----------------------------------------------------------------------------

all: check tclpp.html manpages

check:
	@if test "$(NSGMLS)" = "none" -o "$(SGMLSASP)" = "none" ; then \
		echo "SGML tools not located. Unable to create documentation."; \
		exit 0; \
	fi

tclpp.html: tclpp.sgml manual.dtd
	$(NSGMLS) -D. tclpp.sgml | $(SGMLSASP) translations/html/mapping > asp.out
	./resolve.tcl translations/html/resolve-1 < asp.out > resolve-1.out
	./resolve.tcl translations/html/resolve-2 < resolve-1.out > resolve-2.out
	mv resolve-2.out tclpp.html
	rm *.out

manpages:
	$(NSGMLS) -D. manpages.sgml | $(SGMLSASP) translations/man/mapping > asp.out
	./resolve.tcl translations/man/split < asp.out
	rm *.out

install:
	for i in *.n ; do \
		$(INSTALL) -c $$i $(MANN_INSTALL_DIR) ; \
	done

clean:
	rm -f core *.out *.n

distclean: clean
	rm -rf Makefile config.cache config.log config.status tclpp.html

.c.o:
	$(CC) -c $(CFLAGS) $(CC_SWITCHES) $<

