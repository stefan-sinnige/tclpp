#define VS_VERSION_INFO 1

#define RESOURCE_INCLUDED
#include <tclpp.h>

LANGUAGE 0x9, 0x1	/* LANG_ENGLISH, SUBLANG_DEFAULT */

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 	TCLPP_MAJOR_VERSION,TCLPP_MINOR_VERSION,TCLPP_RELEASE_LEVEL,TCLPP_RELEASE_SERIAL
 PRODUCTVERSION TCLPP_MAJOR_VERSION,TCLPP_MINOR_VERSION,TCLPP_RELEASE_LEVEL,TCLPP_RELEASE_SERIAL
 FILEFLAGSMASK 	0x3fL
 FILEFLAGS 	0x0L
 FILEOS 	0x4	/* VOS__WINDOWS32 */
 FILETYPE 	0x2	/* VFT_DLL */
 FILESUBTYPE 	0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Wishpp Application\0"
            VALUE "OriginalFilename", "wishpp" STRINGIFY(TCLPP_MAJOR_VERSION) STRINGIFY(TCLPP_MINOR_VERSION) ".exe\0"
	    VALUE "Authors", "Stefan Sinnige\0"
            VALUE "CompanyName", "Independent Developer\0"
            VALUE "FileVersion", TCLPP_PATCH_LEVEL
            VALUE "LegalCopyright", "Copyright (c) 2000 by Stefan Sinnige\0"
            VALUE "ProductName", "Wishpp " TCLPP_VERSION " for Windows\0"
            VALUE "ProductVersion", TCLPP_PATCH_LEVEL
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

//
// ICON
//

wishpp		ICON		DISCARDABLE	"wishpp.ico"

