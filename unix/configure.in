AC_INIT(tclAppInit.c)

AC_CONFIG_AUX_DIR(../config)
AC_PROG_INSTALL

dnl ######################################################################
dnl
dnl  VERSION
dnl
dnl Any change in here should be reflected in the tclpp.h header file
dnl as well!
dnl
dnl ######################################################################

TCLPP_VERSION=2.0
TCLPP_MAJOR_VERSION=2
TCLPP_MINOR_VERSION=0
TCLPP_PATCH_LEVEL=".0"
VERSION=${TCLPP_VERSION}

if test "${prefix}" = "NONE"; then
    prefix=/usr/local
fi
if test "${exec_prefix}" = "NONE"; then
    exec_prefix=$prefix
fi

dnl ######################################################################
dnl 
dnl  CHECKS FOR PROGRAMS
dnl 
dnl ######################################################################

dnl ----------------------------------------------------------------------
dnl
dnl Get the 'ranlib' if we can find one.
dnl

AC_PROG_RANLIB

dnl ----------------------------------------------------------------------
dnl
dnl Determine the C-compiler. Add an option to explicitely define the GNU
dnl compiler, since I know that one works perfectly on this program.
dnl

AC_ARG_ENABLE(gcc, 
    [  --enable-gcc            allow use of gcc if available],
    [tclpp_ok=$enableval], [tclpp_ok=no])

if test "$tclpp_ok" = "yes"; then
    AC_PROG_CC
else
    AC_MSG_CHECKING(for c compiler)
    CC=${CC-cc}
    AC_SUBST(CC)
    AC_MSG_RESULT($CC)
fi

dnl ######################################################################
dnl 
dnl  CHECKS FOR INSTALLATION DIRECTORY
dnl 
dnl ######################################################################

dnl ----------------------------------------------------------------------
dnl
dnl Check if we can find the tclConfig.sh which will be used to
dnl retrieve the shell variables as used when building the Tcl/Tk
dnl package. This means that we do not have to get it all ourselves.
dnl

AC_ARG_WITH(tcl, 
    [  --with-tcl=DIR          use Tcl 8.0 libraries from DIR],
    tclpp_search=$withval, tclpp_search='/usr/local/lib /usr/lib')

AC_MSG_CHECKING(for tclConfig.sh)
TCL_LIB_DIR=""
for dir in $tclpp_search; do
    if test -r $dir/tclConfig.sh; then
        TCL_LIB_DIR=$dir
        break
    fi
done

if test -r $TCL_LIB_DIR/tclConfig.sh; then
    AC_MSG_RESULT($TCL_LIB_DIR)
    . $TCL_LIB_DIR/tclConfig.sh
else
    AC_MSG_ERROR(Can't find tclConfig.sh.  Use --with-tcl to specify the directory containing tclConfig.sh on your system.)
fi

dnl ----------------------------------------------------------------------
dnl
dnl Check if we can find the tkConfig.sh which will be used to
dnl retrieve the shell variables as used when building the Tcl/Tk
dnl package. This means that we do not have to get it all ourselves.
dnl

AC_ARG_WITH(tk, 
    [  --with-tk=DIR           use Tk  8.0 libraries from DIR],
    tclpp_search=$withval, tclpp_search='/usr/local/lib /usr/lib')

AC_MSG_CHECKING(for tkConfig.sh)
TK_LIB_DIR=""
for dir in $tclpp_search; do
    if test -r $dir/tkConfig.sh; then
        TK_LIB_DIR=$dir
        break
    fi
done

if test -r $TK_LIB_DIR/tkConfig.sh; then
    AC_MSG_RESULT($TK_LIB_DIR)
    . $TK_LIB_DIR/tkConfig.sh
else
    AC_MSG_ERROR(Can't find tkConfig.sh.  Use --with-tk to specify the directory containing tkConfig.sh on your system.)
fi

dnl ######################################################################
dnl 
dnl  CHECKS FOR LIBRARIES
dnl 
dnl ######################################################################

dnl ----------------------------------------------------------------------
dnl
dnl Check if we can find the tcl libary as specified in tclConfig.sh
dnl

if test -z "$TCL_LIB_DIR"; then
    AC_MSG_ERROR(Can't find Tcl libraries. Use --with-tcl to specify the directory containing tclConfig.sh on your system.)
fi

dnl ----------------------------------------------------------------------
dnl
dnl Check if we can find the tk libary as specified in tkConfig.sh
dnl

if test -z "$TK_LIB_DIR"; then
    AC_MSG_ERROR(Can't find Tk libraries. Use --with-tk to specify the directory containing tclConfig.sh on your system.)
fi

dnl ######################################################################
dnl 
dnl  HEADER FILES
dnl 
dnl ######################################################################

dnl ----------------------------------------------------------------------
dnl
dnl Check if we can find the tclInt.h internal header file from the source
dnl directory specified in tclConfig.sh. We really need this one, because
dnl we use a lot of the internal Tcl core stuff.
dnl

AC_MSG_CHECKING(for tclInt.h)
if test ! -f "$TCL_SRC_DIR/generic/tclInt.h"; then
    AC_MSG_ERROR(Can't find $TCL_SRC_DIR/generic/tclInt.h)
fi
AC_MSG_RESULT($TCL_SRC_DIR/generic/tclInt.h)

dnl ######################################################################
dnl 
dnl  TYPEDEFS
dnl 
dnl ######################################################################

dnl ######################################################################
dnl 
dnl  STRUCTURES
dnl 
dnl ######################################################################

dnl ######################################################################
dnl 
dnl  COMPILER CHARACTERISTICS
dnl 
dnl ######################################################################

dnl ----------------------------------------------------------------------
dnl
dnl Check if we have to build a version with debugging enabled. This can
dnl only be swicthed on with the '--enable-symbols' option.
dnl

AC_ARG_ENABLE(symbols, 
    [  --enable-symbols        build with debugging symbols],
    [tclpp_ok=$enableval], [tclpp_ok=no])

AC_MSG_CHECKING(for debug build)
if test "$tclpp_ok" = "yes"; then
    AC_MSG_RESULT(yes)
    TCLPP_CFLAGS_DEBUG=-g
else
    AC_MSG_RESULT(no)
    TCLPP_CFLAGS_DEBUG=
fi

dnl ----------------------------------------------------------------------
dnl
dnl In case of the GNU compiler, we set special compiler flags.
dnl

if test "${GCC}" = "yes"; then
    TCLPP_CFLAGS_WARNING="-Wall"
fi

dnl ######################################################################
dnl 
dnl  LIBRARY FUNCTIONS
dnl 
dnl ######################################################################

dnl ----------------------------------------------------------------------
dnl 
dnl (SHARED) LIBRARY CREATION 
dnl 
dnl The tclConfig.sh file (created when Tcl is built), contains among
dnl other options, also the compilation options for building shared
dnl libraries and dynamic load options. Only support the creation of 
dnl shared objects when Tcl has been built as such.
dnl
dnl The default options are for creating static libraries.
dnl
dnl The following options are taken over and changed when appropriate:
dnl
dnl     TCL_SHLIB_CFLAGS    Flags to pass to cc when compiling the
dnl                         components of a shared library.
dnl     TCL_SHLIB_LD        Base command to use for combining object
dnl                         files into a shared library.
dnl     TCL_SHLIB_LD_LIBS   Dependent libraries for the linker to scan 
dnl                         when creating shared libraries. This symbol
dnl                         typically goes at the end of the "ld" commands
dnl                         that build shared libraries. 
dnl     TCL_SHLIB_SUFFIX    Suffix to use for the names of dynamically 
dnl                         loadable extensions.
dnl     TCL_DL_LIBS         Library file(s) to include in tclsh and other
dnl                         base applications in order to provide facilities 
dnl                         needed by dynamic loading.
dnl     TK_DL_LIBS          Library file(s) to include in wishpp and other
dnl                         base applications in order to provide facilities 
dnl                         needed by dynamic loading.
dnl     TCL_LD_FLAGS        Flags to pass to the compiler when linking object 
dnl                         files into an executable tclppsh or tclpptest
dnl                         binary.
dnl     TK_LD_FLAGS        Flags to pass to the compiler when linking object 
dnl                         files into an executable wishpp binary.
dnl     TCL_LD_SEARCH_FLAGS Flags to pass to ld that tell the run-time dynamic 
dnl                         linker where to look for shared libraries such as
dnl                         libtcl.so. Used when linking applications.
dnl
dnl The following options are taken over without any change:
dnl
dnl     TCL_DEFS            -D flags for use with the C compiler.
dnl     TCL_DBGX            If TCL was built with debugging symbols, 
dnl                         generated libraries contain this string at the
dnl                         end of the library name (before the extension).
dnl     TCL_LIB_SPEC        String to pass to linker to pick up the Tcl 
dnl                         library from its installed directory.
dnl     TK_LIB_SPEC         String to pass to linker to pick up the Tk 
dnl                         library from its installed directory.
dnl     TCL_LIBS            Additional libraries to use when linking Tcl.
dnl     TK_LIBS             Additional libraries to use when linking Tk.
dnl

TCL_SHLIB_CFLAGS=${TCL_SHLIB_CFLAGS}
TCL_SHLIB_LD=${TCL_SHLIB_LD}
TCL_SHLIB_LD_LIBS=${TCL_SHLIB_LD_LIBS}
TCL_SHLIB_SUFFIX=${TCL_SHLIB_SUFFIX}
TCL_DL_LIBS=${TCL_DL_LIBS}
TK_DL_LIBS=${TK_DL_LIBS}
TCL_DL_FLAGS=${TCL_DL_FLAGS}
TK_DL_FLAGS=${TK_DL_FLAGS}
TCL_LD_FLAGS=${TCL_LD_FLAGS}
TK_LD_FLAGS=${TK_LD_FLAGS}
TCL_LD_SEARCH_FLAGS=${TCL_LD_SEARCH_FLAGS}
TK_LD_SEARCH_FLAGS=${TK_LD_SEARCH_FLAGS}

dnl ----------------------------------------------------------------------
dnl 
dnl Check if we should build a shared library. This can only be done when
dnl the '--enable-shared' has been set AND when the TCL_SHARED_BUILD has
dnl been set to '1' in 'tclConfig.sh'.
dnl

AC_ARG_ENABLE(shared,
    [  --enable-shared         build libtclpp as a shared library],
    [tclpp_ok=$enableval], [tclpp_ok=no])

AC_MSG_CHECKING(for shared library build)
if test "$tclpp_ok" = "yes"; then
    if test ${TCL_SHARED_BUILD} = 0; then
        AC_MSG_ERROR(Tcl was not built with --enable-shared, so you can't use shared libraries.)
    fi
    eval "TCLPP_LIB_FILE=libtclpp${VERSION}${SHLIB_SUFFIX}"
    TCLPP_MAKE_LIB="\$(SHLIB_LD) -o ${TCLPP_LIB_FILE} \$(OBJS) ${SHLIB_LD_LIBS} \$(LD_SEARCH_FLAGS)"
    RANLIB=":"
    AC_MSG_RESULT(yes ($TCLPP_LIB_FILE))
else
    SHLIB_CFLAGS=""
    SHLIB_LD=""
    eval "TCLPP_LIB_FILE=libtclpp${VERSION}.a"
    TCLPP_MAKE_LIB="ar cr \${TCLPP_LIB_FILE} \${OBJS}"
    AC_MSG_RESULT(no ($TCLPP_LIB_FILE))
fi

TCLPP_BUILD_LIB_SPEC="-L`pwd` -ltclpp${VERSION}"

dnl ######################################################################
dnl 
dnl  OUTPUT
dnl 
dnl ######################################################################

AC_SUBST(TCLPP_VERSION)
AC_SUBST(TCLPP_MAJOR_VERSION)
AC_SUBST(TCLPP_MINOR_VERSION)
AC_SUBST(TCLPP_PATCH_LEVEL)
AC_SUBST(TCLPP_CFLAGS_DEBUG)
AC_SUBST(TCLPP_CFLAGS_WARNING)
AC_SUBST(TCL_DL_LIBS)
AC_SUBST(TK_DL_LIBS)
AC_SUBST(TCL_LD_FLAGS)
AC_SUBST(TK_LD_FLAGS)
AC_SUBST(TCL_SHLIB_CFLAGS)
AC_SUBST(TCL_SHLIB_LD)
AC_SUBST(TCL_DEFS)
AC_SUBST(TCL_DBGX)
AC_SUBST(TCL_LIB_SPEC)
AC_SUBST(TK_LIB_SPEC)
AC_SUBST(TCL_LIBS)
AC_SUBST(TK_LIBS)
AC_SUBST(TCL_SRC_DIR)
AC_SUBST(TCLPP_MAKE_LIB)
AC_SUBST(TCLPP_BUILD_LIB_SPEC)
AC_SUBST(TCLPP_LIB_FILE)
AC_SUBST(INSTALLDIR)

AC_OUTPUT(
    tclppConfig.sh
    Makefile)

dnl vi: set expandtab ts=4:

