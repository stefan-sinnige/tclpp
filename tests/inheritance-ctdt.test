if {[string compare test [info commands test]] == 1} {
    error "This test requires the 'tclpptest' shell."
    exit 1
}

set SECTION 5.5

# -----------------------------------------------------------------------------

test inheritance-ctdt-R-${SECTION}.1-1 \
{
    The constructors of all base classes are invoked. Base classes are
    constructed before derived classes.
} \
{
    set result ""
    class Base1 {
        proc Base1 {} {
            global result
            append result "Base1::Base1 - "
        }
    }
    class Base2 : Base1 {
        proc Base2 {} {
            global result
            append result "Base2::Base2 - "
        }
    }
    class Derived : Base2 {
        proc Derived {} {
            global result
            append result "Derived::Derived - "
        }
    }
    Derived d
    set result
} "Base1::Base1 - Base2::Base2 - Derived::Derived - "

# -----------------------------------------------------------------------------

test inheritance-ctdt-R-${SECTION}.1-2 \
{
    The constructors of all base classes are invoked. Base classes are
    constructed before derived classes.
} \
{
    set result ""
    class Base1 {
        proc Base1 {} {
            global result
            append result "Base1::Base1 - "
        }
    }
    class Base2 : Base1 {
        proc Base2 {} {
            global result
            append result "Base2::Base2 - "
        }
    }
    class Derived : Base2 {
        proc Derived {} {
            global result
            append result "Derived::Derived - "
        }
    }
    class AClass {
        proc AClass {} {
            global result
            append result "AClass::AClass - "
        }
        variable Derived d
    }
    AClass a
    set result
} "Base1::Base1 - Base2::Base2 - Derived::Derived - AClass::AClass - "

# -----------------------------------------------------------------------------

test inheritance-ctdt-R-${SECTION}.2-1 \
{
    The destructors of all base classes are invoked. Derived classes are
    destructed before base classes.
} \
{
    set result ""
    class Base1 {
        proc ~Base1 {} {
            global result
            append result "Base1::~Base1 - "
        }
    }
    class Base2 : Base1 {
        proc ~Base2 {} {
            global result
            append result "Base2::~Base2 - "
        }
    }
    class Derived : Base2 {
        proc ~Derived {} {
            global result
            append result "Derived::~Derived - "
        }
    }
    Derived d
    d delete
    set result
} "Derived::~Derived - Base2::~Base2 - Base1::~Base1 - "

# -----------------------------------------------------------------------------

test inheritance-ctdt-R-${SECTION}.2-2 \
{
    The destructors of all base classes are invoked. Derived classes are
    destructed before base classes.
} \
{
    set result ""
    class Base1 {
        proc ~Base1 {} {
            global result
            append result "Base1::~Base1 - "
        }
    }
    class Base2 : Base1 {
        proc ~Base2 {} {
            global result
            append result "Base2::~Base2 - "
        }
    }
    class Derived : Base2 {
        proc ~Derived {} {
            global result
            append result "Derived::~Derived - "
        }
    }
    class AClass {
        proc ~AClass {} {
            global result
            append result "AClass::~AClass - "
        }
        variable Derived d
    }
    AClass a
    a delete
    set result
} "AClass::~AClass - Derived::~Derived - Base2::~Base2 - Base1::~Base1 - "

