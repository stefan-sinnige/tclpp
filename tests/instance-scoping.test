if {[string compare test [info commands test]] == 1} {
    error "This test requires the 'tclpptest' shell."
    exit 1
}

set SECTION 4.4

# -----------------------------------------------------------------------------

test instance-scoping-R-${SECTION}.1-1 \
{
    Instances defined in a namespace are accessible through that namespace
} \
{
    namespace eval A {
	    class B {
	    }
        B b
    }
    A::B b
    list [classinfo classes] \
         [info commands b] \
         [namespace eval A {info commands b}]
} "::A::B\
   b\
   b"

# -----------------------------------------------------------------------------

test instance-scoping-R-${SECTION}.1-2 \
{
    Deleting a namespace which defines instances, will remove these
    instances as well.
} \
{
	class B {
    }
    namespace eval A {
        B b
    }
    namespace delete A
    A::b
} "invalid command name \"A::b\""

# -----------------------------------------------------------------------------

test instance-names-R-${SECTION}.2-1 \
{
    Instances created in a global procedure become available in the global
    namespace
} \
{
    class A {}
    proc create {} {
        A a
    }
    create
    list [info commands a] [info commands ::a]
} "a\
   ::a"

# -----------------------------------------------------------------------------

test instance-names-R-${SECTION}.2-2 \
{
    Instances created by a namespace procedure become a member of that
    namespace, ven though it was called from a different namespace.
} \
{
    class A {}
    namespace eval P {
        proc create {} {
            A a
        }
    }
    namespace eval N {
        ::P::create
    }
    list [info commands P::a] 
} "::P::a"

