if {[string compare test [info commands test]] == 1} {
    error "This test requires the 'tclpptest' shell."
    exit 1
}

set SECTION 5.3

# -----------------------------------------------------------------------------

test inheritance-methods-R-${SECTION}.1-1 \
{
    Methods from base classes are directly accessible in the derived class.
} \
{
    class Base {
        proc base_func {} {
            return "base_func"
        }
    }
    class Derived : Base {
    }
    Derived d
    d base_func
} "base_func"

# -----------------------------------------------------------------------------

test inheritance-methods-R-${SECTION}.1-2 \
{
    Methods from base classes are accessible in the derived class methods.
} \
{
    class Base {
        proc base_func {} {
            return "base_func"
        }
    }
    class Derived : Base {
        proc derived_func {} {
            return [base_func]
        }
    }
    Derived d
    d derived_func
} "base_func"

# -----------------------------------------------------------------------------

test inheritance-methods-R-${SECTION}.1-3 \
{
    Non-virtual methods from derived classes are not accessible in the base 
    class methods.
} \
{
    class Base {
        proc base_func {} {
            return [derived_func]
        }
    }
    class Derived : Base {
        proc derived_func {} {
            return "derived_func"
        }
    }
    Derived d
    d base_func
} "invalid command name \"derived_func\""

# -----------------------------------------------------------------------------

test inheritance-methods-R-${SECTION}.2-1 \
{
    Non-virtual base class methods cannot be overloaded by derived classes.
} \
{
    class Base {
        proc func {} {
        }
    }
    class Derived : Base {
        proc func {} {
        }
    }
    Derived d
} "method \"::Derived::func\" cannot override non-virtual \"::Base::func\""

# -----------------------------------------------------------------------------

test inheritance-methods-R-${SECTION}.2-2 \
{
    Non-virtual base class methods cannot be overloaded by other base classes.
} \
{
    class Base1 {
        proc func {} {
        }
    }
    class Base2 {
        proc func {} {
        }
    }
    class Derived : Base1 Base2 {
    }
    Derived d
} "method \"::Base1::func\" hides \"::Base2::func\" (Ambiguity)"

# -----------------------------------------------------------------------------

test inheritance-methods-R-${SECTION}.2-3 \
{
    Non-virtual base class methods cannot be overloaded by the derived and
    other base classes altogether.
} \
{
    class Base1 {
        proc func {} {
        }
    }
    class Base2 {
        proc func {} {
        }
    }
    class Derived : Base1 Base2 {
        proc func {} {
        }
    }
    Derived d
} "method \"::Derived::func\" cannot override non-virtual \"::Base1::func\""

