if {[string compare test [info commands test]] == 1} {
    error "This test requires the 'tclpptest' shell."
    exit 1
}

# -----------------------------------------------------------------------------

test basec-1 \
{
    Tclpp version information
} \
{
    list [set tclpp_version] \
         [set tclpp_patchLevel]
} "2.0 2.0.0"

