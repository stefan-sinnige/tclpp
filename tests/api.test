if {[string compare test [info commands test]] == 1} {
    error "This test requires the 'tclpptest' shell."
    exit 1
}

# -----------------------------------------------------------------------------

test API-1 \
{
    Tclpp_CreateClass (interp, fullName, description);
} \
{
    testclass ::A {}
    list [classinfo classes]    
} "::A"


# -----------------------------------------------------------------------------

test API-2 \
{
    Tclpp_CreateInstance (interp, instanceName, classPtr);
} \
{
    class A {}
    testinstance create ::a ::A
    list [objectinfo a isA]
} "::A"

# -----------------------------------------------------------------------------

test API-3 \
{
    Tclpp_DeleteInstance (interp, instancePtr);
} \
{
    class A {}
    A a
    testinstance delete ::a 
    list [info commands ::a] \
         [namespace children :: a]
} "{}\
   {}"

# vi: set ai ts=4 expandtab:

