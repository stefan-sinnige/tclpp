if {[string compare test [info commands test]] == 1} {
    error "This test requires the 'tclpptest' shell."
    exit 1
}

set SECTION 5.4

# -----------------------------------------------------------------------------

test inheritance-methods-R-${SECTION}.1-1 \
{
    Only methods can be adorned with the virtual keyword
} \
{
    class Base {
        virtual proc func {arg1} {
        }
    }
} ""

# -----------------------------------------------------------------------------

test inheritance-methods-R-${SECTION}.1-2 \
{
    Only methods can be adorned with the virtual keyword
} \
{
    class Base {
        virtual variable hello
    }
} "wrong # args: should be \"virtual proc name args body\""

# -----------------------------------------------------------------------------

test inheritance-methods-R-${SECTION}.1-2 \
{
    Only methods can be adorned with the virtual keyword
} \
{
    class Base {
        virtual non_proc hello {} {
        }
    }
} "'virtual' keyword not followed by 'proc'"

# -----------------------------------------------------------------------------

test inheritance-methods-R-${SECTION}.2-1 \
{
    A derived class can only override a virtual method
} \
{
    class Base {
        proc func {} {
            return "Base::func"
        }
    }
    class Derived : Base {
        virtual proc func {} {
            return "Derived::func"
        }
    }
} "method \"::Derived::func\" cannot override non-virtual \"::Base::func\""

# -----------------------------------------------------------------------------

test inheritance-methods-R-${SECTION}.2-2 \
{
    An instance of the derived class will always invoke the latest overridden
    method.
} \
{
    class Base {
        virtual proc virtual_func {} {
            return "Base::virtual_func"
        }
    }
    class Derived : Base {
        virtual proc virtual_func {} {
            return "Derived::virtual_func"
        }
    }
    Base b
    Derived d
    list [b virtual_func] \
         [d virtual_func]
} "Base::virtual_func\
   Derived::virtual_func"

# -----------------------------------------------------------------------------

test inheritance-methods-R-${SECTION}.2-3 \
{
    An instance of the derived class will always invoke the latest overridden
    method. Even if it was invoked through the base class.
} \
{
    class Base {
        virtual proc virtual_func {} {
            return "Base::virtual_func"
        }
        proc callit {} {
            virtual_func
        }
    }
    class Derived : Base {
        virtual proc virtual_func {} {
            return "Derived::virtual_func"
        }
    }
    Base b
    Derived d
    list [b callit] \
         [d callit]
} "Base::virtual_func\
   Derived::virtual_func"

# -----------------------------------------------------------------------------

test inheritance-methods-R-${SECTION}.2-4 \
{
    An instance of the derived class will always invoke the latest overridden
    method. Even in complex chained inheritance.
} \
{
    class Base {
        virtual proc virtual_func {} {
            return "Base::virtual_func"
        }
    }
    class Derived1 : Base {
    }
    class Derived2 : Derived1 {
        virtual proc virtual_func {} {
            return "Derived2::virtual_func"
        }
    }
    class Derived3 : Derived2 {
    }
    Base b
    Derived1 d1
    Derived2 d2
    Derived3 d3
    list [b  virtual_func] \
         [d1 virtual_func] \
         [d2 virtual_func] \
         [d3 virtual_func]
} "Base::virtual_func\
   Base::virtual_func\
   Derived2::virtual_func\
   Derived2::virtual_func"

# -----------------------------------------------------------------------------

test inheritance-methods-R-${SECTION}.3-1 \
{
    In case of multiple inheritance, an ambigeous situation can only be
    relieved when both base classes define the function as virtual AND it
    is overloaded by the derived class.
} \
{
    class Base1 {
        virtual proc func {} {
            return "Base1::func"
        }
    }
    class Base2 {
        virtual proc func {} {
            return "Base1::func"
        }
    }
    class Derived : Base1 Base2 {
    }
} "method \"::Base1::func\" hides \"::Base2::func\" (Ambiguity)"

# -----------------------------------------------------------------------------

