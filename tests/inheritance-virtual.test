        }
    }
    class Base2 {
        virtual proc func {} {
            return "Base1::func"
        }
    }
    class Derived : Base1 Base2 {
        virtual proc func {} {
            return "Derived::func"
        }
    }
    Derived d
    d func
} "Derived::func"

