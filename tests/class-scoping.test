if {[string compare test [info commands test]] == 1} {
    error "This test requires the 'tclpptest' shell."
    exit 1
}

set SECTION 3.5

# -----------------------------------------------------------------------------

test class-scoping-R-${SECTION}.1-1 \
{
    Classes defined in a namespace are accessible through that namespace
} \
{
    namespace eval A {
	    class B {
	    }
    }
    A::B b
    list [classinfo classes] \
         [namespace eval A {info commands B}]
} "::A::B\
   B"

# -----------------------------------------------------------------------------

test class-scoping-R-${SECTION}.2-1 \
{
    Classes defined in a namespace are accessible through that namespace
    even though they are created through a procedure
} \
{
    namespace eval A {
        proc create {} {
	        class B {
            }
	    }
        create
    }
    A::B b
    list [classinfo classes] \
         [namespace eval A {info commands B}]
} "::A::B\
   B"

# vi: set ai ts=4 expandtab:

