set tests [list                 \
    basic.test                  \
    class-names.test            \
    class-methods.test          \
    class-variables.test        \
    class-ctdt.test             \
    class-scoping.test          \
    instance-names.test         \
    instance-variables.test     \
    instance-methods.test       \
    instance-scoping.test       \
    inheritance-basics.test     \
    inheritance-ctdt.test       \
    inheritance-variables.test  \
    inheritance-methods.test    \
    inheritance-virtual.test    \
    api.test                    \
]

foreach i $tests {
    puts stdout $i
    if [catch {source $i} msg] {
        puts $msg
    }
}

