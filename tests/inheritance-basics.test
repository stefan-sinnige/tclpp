if {[string compare test [info commands test]] == 1} {
    error "This test requires the 'tclpptest' shell."
    exit 1
}

set SECTION 5.1

# -----------------------------------------------------------------------------

test inheritance-basics-R-${SECTION}.1-1 \
{
    Inheritance is specified at class definition by specifying a list of
    base classes.
} \
{
    class Base1 {
    }
    class Base2 : Base1 {
    }
    class Derived : Base2 {
    }
    list [classinfo heritage Base1] \
         [classinfo heritage Base2] \
         [classinfo heritage Derived]    
} "{}\
   Base1\
   Base2"

# -----------------------------------------------------------------------------

test inheritance-basics-R-${SECTION}.1-2 \
{
    Base classes must be known before they are used.
} \
{
    class Derived : Base {
    }
} "base class \"Base\" unknown"

# -----------------------------------------------------------------------------

test inheritance-basics-R-${SECTION}.1-3 \
{
    Object information
} \
{
    class Base1 {
    }
    class Base2 : Base1 {
    }
    class Derived : Base2 {
    }
    Base1 b
    Derived d
    list [objectinfo b isA]\
         [objectinfo b isKindOf Base1]\
         [objectinfo b isKindOf Base2]\
         [objectinfo d isA]\
         [objectinfo d isKindOf Derived]\
         [objectinfo d isKindOf Base2]\
         [objectinfo d isKindOf Base1]\

} "::Base1\
   1\
   0\
   ::Derived\
   1\
   1\
   1"

# vi: set ai ts=4 expandtab:

