# END OF USER CONFIGURABLE SETTINGS
#
#######################################################################

all: test

test: ../src/tclpptest
	$(MAKE) -C ../src test
	@if test -f core; then\
 	    echo "";\
            echo "** A 'core' file exists. It might have been generated";\
	    echo "** during the test. Please verify.";\
 	    echo "";\
	    exit 1;\
	fi

clean:
	rm -f Makefile
	rm -f test.tcl

distclean: clean

../src/tclpptest:
	$(MAKE) -C ../src tclpptest
	
