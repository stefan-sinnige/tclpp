if {[string compare test [info commands test]] == 1} {
    error "This test requires the 'tclpptest' shell."
    exit 1
}

set SECTION 3.1

# -----------------------------------------------------------------------------

test class-names-R-${SECTION}.1-1 \
{
    Class name defined in the global namespace should be accessible by both
    the class name itself and the fully qualified class name.
} \
{
    class A {}
    list [info commands A] \
         [info commands ::A] \
         [classinfo classes]
} "A\
   ::A\
   ::A"

# -----------------------------------------------------------------------------

test class-names-R-${SECTION}.1-2 \
{
    Class name defined in any namespace should be accessible by both the 
    class name itself in the namespace and the fully qualified class name
    outside the namespace.
} \
{
    namespace eval Dummy {
        class A {}
        namespace which -command A
    }
    class A {} 
    list [namespace eval Dummy {namespace which -command A}] \
         [namespace which -command A] \
	     [lsort [classinfo classes]]
} "::Dummy::A\
   ::A\
   {::A ::Dummy::A}"

# -----------------------------------------------------------------------------

test class-names-R-${SECTION}.1-3 \
{
    Class name can clash with a namespace of the same name
} \
{
    namespace eval A {}
    class A {}
} "can't create namespace \"::A\": already exists"

# -----------------------------------------------------------------------------

test class-names-R-${SECTION}.1-4 \
{
    Nested clases can be accessed by their fully qualified name corresponding
    to their nested namespace
} \
{
    class A {
        class B {
        }
    }
    list [info commands ::A] \
         [info commands ::A::B] \
    	 [lsort [classinfo classes]]
} "::A\
   ::A::B\
   {::A ::A::B}"

# -----------------------------------------------------------------------------

test class-names-R-${SECTION}.2-1 \
{
    Classes can be defined only once.
} \
{
    class A {}
    class A {}
} "class \"::A\" already exists"

# -----------------------------------------------------------------------------

test class-names-R-${SECTION}.3-1 \
{
    Classes cannot interfere with already existing commands
} \
{
    proc A {} {
    }
    class A {}
} "command \"::A\" already exists"

# -----------------------------------------------------------------------------

test class-names-R-${SECTION}.3-2 \
{
    Procedures can interfere with already existing class instantation 
    functions, thus silently overwriting the class instantiation function.
} \
{
    class A {}
    proc A {} {
        return Oops
    }
    A 
} "Oops"

